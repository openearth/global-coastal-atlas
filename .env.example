MAPBOX_ACCESS_TOKEN=""

# GeoServer WMS publishing (used by STAC template notebooks, step 9 — remote)
GEOSERVER_URL="https://international-delta-platform.avi.directory.intra/geoserver"
GEOSERVER_USERNAME="admin"
GEOSERVER_PASSWORD="your-geoserver-password-here"
# false for the self-signed certificate of the Deltares GeoServer
GEOSERVER_VERIFY_SSL="false"

# Local GeoServer (used by STAC notebooks, step 10 — docker compose in STAC/data/geoserver)
LOCAL_GEOSERVER_URL="http://localhost:8085/geoserver"
LOCAL_GEOSERVER_USERNAME="admin"
LOCAL_GEOSERVER_PASSWORD="geoserver"
